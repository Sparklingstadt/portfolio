---
// Generated from the original mock; shared text comes from src/data/site.json.
import { certification, mockDataJson, profileLinks, profileText, text } from '../../../lib/site.js';
---
<!doctype html>
<html lang="ja" data-design="macos" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>最新案 4つのデザイン</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&amp;family=Noto+Sans+JP:wght@400;500;700&amp;family=Noto+Sans+SC:wght@500;700&amp;family=Roboto+Flex:opsz,wght@8..144,400;8..144,500;8..144,700&amp;family=Roboto+Mono:wght@400;500&amp;display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0..1,0&amp;display=block">
<link rel="stylesheet" href="style.css">
<script src="script.js" defer is:inline></script>
<script type="application/json" id="mock-data" set:html={mockDataJson}></script>
<script src="../data.js" defer is:inline></script>
</head>
<body>
<div class="page">

<div class="controls">
  <span class="controls-label">デザイン</span>
  <div class="seg seg--ctl seg--mode" role="group" aria-label="デザインの切り替え" data-control="design">
    <button type="button" aria-pressed="true" data-value="macos"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>macOS</button>
    <button type="button" aria-pressed="false" data-value="hyprland"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>Arch + Hyprland</button>
    <button type="button" aria-pressed="false" data-value="material"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>Material 3</button>
    <button type="button" aria-pressed="false" data-value="harmonyos"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>HarmonyOS</button>
  </div>
  <div class="seg seg--ctl seg--lang" role="group" aria-label="表示言語" data-control="lang">
    <button type="button" lang="ja" aria-pressed="true" data-value="ja"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>JA</button>
    <button type="button" lang="zh-Hans" aria-pressed="false" data-value="zh-Hans"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>中</button>
    <button type="button" lang="ru" aria-pressed="false" data-value="ru"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>RU</button>
    <button type="button" lang="cs" aria-pressed="false" data-value="cs"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>CS</button>
    <button type="button" lang="en" aria-pressed="false" data-value="en"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>EN</button>
  </div>
  <ul class="diffs" id="diffs">
    <li>ウインドウ: タイトルバーと3つのボタン</li>
    <li>奥行き: 影で重なりを示す</li>
    <li>選択: 小さめのセグメントコントロール</li>
    <li>スイッチ: アクセントカラーのトグル</li>
    <li>書体: システムフォント</li>
  </ul>
</div>

<div class="stage">
<div class="wall">

  <!-- macOS: menu bar -->
  <div class="menubar only-macos">
    <span class="menubar-name"><span data-profile="name">{profileText.name}</span></span>
    <span>ファイル</span><span>編集</span><span>表示</span><span>ウインドウ</span>
    <span class="menubar-clock" data-clock="mac">--:--</span>
  </div>

  <!-- Hyprland: Waybar -->
  <div class="waybar-wrap only-hyprland">
    <div class="waybar">
      <span class="ws">
        <span class="ws-item ws-item--on">1</span>
        <span class="ws-item">2</span>
        <span class="ws-item">3</span>
      </span>
      <span class="waybar-title">about — <span data-profile="name">{profileText.name}</span></span>
      <span class="waybar-cpu" data-content="rice.cpu">{text('rice.cpu')}</span>
      <span class="waybar-vol" data-content="rice.volume">{text('rice.volume')}</span>
      <span class="waybar-clock" data-clock="hypr">--:--</span>
    </div>
  </div>

  <!-- Material 3: top app bar -->
  <div class="m3-topbar only-material">
    <span class="m3-topbar-name"><span data-profile="name">{profileText.name}</span></span>
    <nav class="m3-nav" aria-label="セクション">
      <a href="#projects" data-content="label.projects">{text('label.projects')}</a>
      <a href="#rice">Linux</a>
      <a href="#notes" data-content="label.notes">{text('label.notes')}</a>
      <a href="#contact" data-content="label.contact">{text('label.contact')}</a>
    </nav>
    <button type="button" class="m3-icon-btn" aria-label="ダークテーマを切り替える" data-action="toggle-dark"><span class="material-symbols-rounded icon-to-dark" aria-hidden="true">dark_mode</span><span class="material-symbols-rounded icon-to-light" aria-hidden="true">light_mode</span></button>
  </div>

  <!-- HarmonyOS: large title -->
  <div class="hm-title only-harmonyos">
    <div class="hm-title-text">
      <span class="hm-title-name"><span data-profile="name">{profileText.name}</span></span>
      <span class="hm-title-sub" data-content="role">{text('role')}</span>
    </div>
    <nav class="hm-nav" aria-label="セクション">
      <a href="#projects" data-content="label.projects">{text('label.projects')}</a>
      <a href="#rice">Linux</a>
      <a href="#notes" data-content="label.notes">{text('label.notes')}</a>
      <a href="#contact" data-content="label.contact">{text('label.contact')}</a>
    </nav>
  </div>

  <div class="tiles">

    <!-- Hero -->
    <div class="frame frame--hero" style="--basis: 3 1 520px">
      <div class="win win--hero">
        <div class="titlebar only-macos">
          <span class="lights lights--color" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title">about</span>
        </div>
        <div class="hero-body">
          <p class="greetings">
            <span lang="ja" data-content-lang="greeting">{text('greeting.ja')}</span><span lang="zh-Hans" class="font-sc" data-content-lang="greeting">{text('greeting.zh-Hans')}</span><span lang="ru" data-content-lang="greeting">{text('greeting.ru')}</span><span lang="cs" data-content-lang="greeting">{text('greeting.cs')}</span>
          </p>
          <h1 class="tagline" id="tagline" lang="ja" data-content-lang="tagline">{text('tagline.ja')}</h1>
          <p class="intro">Webエンジニア志望の <span data-profile="name">{profileText.name}</span> です。macOS の、おしゃれなのに実用的なデザインが好きです。Arch Linux と Hyprland で自分の環境を作り込むうちに、Linux そのものにも惹かれました。TypeScript を軸に Go と Kotlin を学び、中国語・ロシア語・チェコ語も勉強しています。</p>
          <div class="actions">
            <a class="cta" href="#contact"><span class="material-symbols-rounded only-material" aria-hidden="true">mail</span><span data-content="label.contactMe">{text('label.contactMe')}</span></a>
            <a class="btn2" href="#projects" data-content="label.viewProjects">{text('label.viewProjects')}</a>
          </div>
        </div>
      </div>
    </div>

    <!-- me.ts / Index.ets -->
    <div class="frame" style="--basis: 2 1 340px">
      <div class="win win--code">
        <div class="titlebar titlebar--dark only-macos">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title">me.ts</span>
        </div>
        <div class="file-label only-material"><span class="material-symbols-rounded" aria-hidden="true">data_object</span>me.ts</div>
        <div class="file-label file-label--hm only-harmonyos">Index.ets(ArkTS)</div>
        <div class="code-scroll not-harmonyos">
<pre class="code code--me"><span class="kw">interface</span> Me {'{'}
  <span class="prop">role</span>: <span class="str">"Web Engineer"</span>;
  <span class="prop">stack</span>: [<span class="str">"TypeScript"</span>, <span class="str">"Node.js"</span>];
  <span class="prop">learning</span>: [<span class="str">"Go"</span>, <span class="str">"Kotlin"</span>];
  <span class="prop">desktop</span>: [<span class="str">"macOS"</span>, <span class="str">"Arch + Hyprland"</span>];
  <span class="prop">viewingAs</span>: <span class="str">"<span id="viewing-as">macOS</span>"</span>;
{'}'}</pre>
        </div>
        <div class="code-scroll only-harmonyos">
<pre class="code code--ets"><span class="kw">@Entry</span>
<span class="kw">@Component</span>
<span class="kw">struct</span> <span class="prop">Me</span> {'{'}
  <span class="kw">@State</span> lang: string = <span class="str">'zh-Hans'</span>

  <span class="prop">build</span>() {'{'}
    <span class="prop">Column</span>({'{'} space: <span class="str">12</span> {'}'}) {'{'}
      <span class="prop">Text</span>(<span class="str">'你好'</span>)
        .fontSize(<span class="str">30</span>)
        .fontWeight(FontWeight.Bold)
      <span class="prop">Text</span>(<span class="str">'Web Engineer · TypeScript'</span>)
    {'}'}
    .padding(<span class="str">16</span>)
  {'}'}
{'}'}</pre>
        </div>
      </div>
    </div>

    <!-- Projects -->
    <div class="frame" id="projects" style="--basis: 2 1 480px">
      <div class="win">
        <div class="titlebar only-macos">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title" data-content="label.projects">{text('label.projects')}</span>
        </div>
        <div class="card-body card-body--projects">
          <div class="projects-head">
            <h2><span class="material-symbols-rounded only-material" aria-hidden="true">folder</span><span data-content="label.projects">{text('label.projects')}</span></h2>
            <div class="seg seg--filter" role="group" aria-label="種類で絞り込む" data-control="filter">
              <button type="button" aria-pressed="true" data-value="all"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span><span data-content="label.filterAll">{text('label.filterAll')}</span></button>
              <button type="button" aria-pressed="false" data-value="web"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>Web</button>
              <button type="button" aria-pressed="false" data-value="linux"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span>Linux</button>
              <button type="button" aria-pressed="false" data-value="mobile"><span class="material-symbols-rounded seg-check" aria-hidden="true">check</span><span data-content="label.filterMobile">{text('label.filterMobile')}</span></button>
            </div>
          </div>
          <div class="projects">
            <a class="proj" href="#projects" data-kind="web">
              <span class="proj-name" data-content="project.name1">{text('project.name1')}</span>
              <span class="proj-desc" data-content="project.description1">{text('project.description1')}</span>
              <span class="proj-stack" data-content="project.stackWeb">{text('project.stackWeb')}</span>
            </a>
            <a class="proj" href="#projects" data-kind="linux">
              <span class="proj-name">dotfiles</span>
              <span class="proj-desc" data-content="project.dotfiles">{text('project.dotfiles')}</span>
              <span class="proj-stack">Shell · [その他]</span>
            </a>
            <a class="proj" href="#projects" data-kind="linux">
              <span class="proj-name" data-content="project.name2">{text('project.name2')}</span>
              <span class="proj-desc">[Go で作った CLI ツール]</span>
              <span class="proj-stack">Go</span>
            </a>
            <a class="proj" href="#projects" data-kind="mobile">
              <span class="proj-name" data-content="project.name3">{text('project.name3')}</span>
              <span class="proj-desc">[Kotlin で作ったアプリ]</span>
              <span class="proj-stack">Kotlin · Compose</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Rice -->
    <div class="frame" style="--basis: 1 1 300px">
      <div class="win">
        <div class="titlebar only-macos">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title" data-content="label.riceToLinux">{text('label.riceToLinux')}</span>
        </div>
        <div class="card-body card-body--rice" id="rice">
          <h2><span class="material-symbols-rounded only-material" aria-hidden="true">terminal</span><span data-content="label.riceToLinux">{text('label.riceToLinux')}</span></h2>
          <ol class="steps">
            <li><span class="step-num">1</span><span data-content="rice.step1">{text('rice.step1')}</span></li>
            <li><span class="step-num">2</span><span data-content="rice.step2">{text('rice.step2')}</span></li>
            <li><span class="step-num">3</span><span data-content="rice.step3">{text('rice.step3')}</span></li>
          </ol>
        </div>
      </div>
    </div>

    <!-- Terminal -->
    <div class="frame" style="--basis: 1 1 340px">
      <div class="win win--term">
        <div class="titlebar titlebar--dark only-macos">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title">Terminal — fastfetch</span>
        </div>
        <div class="term">
          <span><span class="t-prompt">❯</span> fastfetch</span>
          <span class="t-user"><span data-profile="name">{profileText.name}</span>@[host]</span>
          <span class="t-rule">───────────────</span>
          <span><span class="t-key">OS</span> Arch Linux x86_64</span>
          <span><span class="t-key">WM</span> Hyprland</span>
          <span><span class="t-key">Bar</span> <span data-content="rice.bar">{text('rice.bar')}</span></span>
          <span><span class="t-key">Shell</span> <span data-content="rice.shell">{text('rice.shell')}</span></span>
          <span><span class="t-key">Terminal</span> <span data-content="rice.terminal">{text('rice.terminal')}</span></span>
          <span><span class="t-key">Theme</span> <span data-content="rice.theme">{text('rice.theme')}</span></span>
          <span class="t-swatches" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
        </div>
      </div>
    </div>

    <!-- hyprland.conf -->
    <div class="frame" style="--basis: 1 1 340px">
      <div class="win win--code">
        <div class="titlebar titlebar--dark only-macos">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title">hyprland.conf</span>
        </div>
        <div class="file-label only-material"><span class="material-symbols-rounded" aria-hidden="true">settings</span>hyprland.conf</div>
        <div class="code-scroll">
<pre class="code code--conf"><span class="cm"># Hyprland 表示の隙間と角丸はこの値</span>
<span class="kw">general</span> {'{'}
  <span class="prop">gaps_in</span> = <span class="str">5</span>
  <span class="prop">gaps_out</span> = <span class="str">10</span>
  <span class="prop">border_size</span> = <span class="str">2</span>
{'}'}
<span class="kw">decoration</span> {'{'}
  <span class="prop">rounding</span> = <span class="str">10</span>
{'}'}
<span class="prop">bind</span> = SUPER, Return, exec, [kitty]</pre>
        </div>
      </div>
    </div>

    <!-- Notes -->
    <div class="frame" id="notes" style="--basis: 1 1 340px">
      <div class="win">
        <div class="titlebar only-macos">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title" data-content="label.notes">{text('label.notes')}</span>
        </div>
        <div class="card-body card-body--notes">
          <h2><span class="material-symbols-rounded only-material" aria-hidden="true">edit_note</span><span data-content="label.notes">{text('label.notes')}</span></h2>
          <a class="note" href="#notes"><span class="note-kind" data-content="note.kindUiux">{text('note.kindUiux')}</span><span class="note-title">[macOS・HIG・Material の読み比べ]</span></a>
          <a class="note" href="#notes"><span class="note-kind">Linux</span><span class="note-title">[Rice ログ: Hyprland の設定で学んだこと]</span></a>
          <a class="note" href="#notes"><span class="note-kind" data-content="note.kindTech">{text('note.kindTech')}</span><span class="note-title">[Web標準・Node.js の記事]</span></a>
          <a class="note" href="#notes"><span class="note-kind" data-content="note.kindLanguage">{text('note.kindLanguage')}</span><span class="note-title" data-content="note.languages">{text('note.languages')}</span></a>
        </div>
      </div>
    </div>

    <!-- Certifications -->
    <div class="frame" id="certifications" style="--basis: 1 1 300px">
      <div class="win">
        <div class="titlebar only-macos">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title" data-content="label.certifications">{text('label.certifications')}</span>
        </div>
        <div class="card-body card-body--contact">
          <h2><span class="material-symbols-rounded only-material" aria-hidden="true">workspace_premium</span><span data-content="label.certifications">{text('label.certifications')}</span></h2>
          <span data-certification="hsk1">{certification('hsk1')}</span>
          <span data-certification="hsk2">{certification('hsk2')}</span>
          <span data-certification="hsk3">{certification('hsk3')}</span>
          <span data-certification="hsk4">{certification('hsk4')}</span>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="frame" id="contact" style="--basis: 1 1 300px">
      <div class="win">
        <div class="titlebar only-macos">
          <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="titlebar-title">連絡先と表示</span>
        </div>
        <div class="card-body card-body--contact">
          <h2><span class="material-symbols-rounded only-material" aria-hidden="true">mail</span><span data-content="label.contact">{text('label.contact')}</span></h2>
          <span><span data-content="label.email">{text('label.email')}</span> <span class="email"><span data-profile="email">{profileText.email}</span></span></span>
          <a class="github" href={profileLinks.github} data-profile-link="github">GitHub <span data-profile="github">{profileText.github}</span></a>
          <div class="settings-row">
            <span class="ctp-note only-hyprland">配色: Catppuccin Mocha(常にダーク)</span>
            <label class="not-hyprland" for="tri-dark" data-content="label.darkMode">{text('label.darkMode')}</label>
            <button id="tri-dark" class="switch not-hyprland" type="button" role="switch" aria-checked="false" data-action="toggle-dark"><span class="switch-thumb" aria-hidden="true"><span class="material-symbols-rounded switch-check">check</span></span></button>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
<p class="footnote">4つの見た目は同じ HTML です。色・角丸・隙間・書体などの値(デザイントークン)だけを差し替えています。HarmonyOS 表示の書体は HarmonyOS Sans を指定し、入っていない環境では Noto Sans で代替します。実際のサイトでは &lt;html data-design="macos | hyprland | material | harmonyos"&gt; と CSS カスタムプロパティで切り替え、選択を保存します。</p>
</div>

</div>
</body>
</html>
